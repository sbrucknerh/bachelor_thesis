%% System overview: how the research questions map to datasets, through the
%% shared locked pipeline, to the reported results.
%% The pipeline itself is detailed in 01-pipeline.
flowchart TD

    subgraph RQ["Research questions"]
        direction LR
        Q1["RQ1<br/>Do motifs add signal<br/>over the baseline?"]
        Q2["RQ2<br/>At which time<br/>window &delta;?"]
        Q3["RQ3<br/>Do categories differ in<br/>motifs and time scale?"]
        Q1 ~~~ Q2 ~~~ Q3
    end

    subgraph DATA["Datasets"]
        direction LR
        HF["HuggingFace ETH Fraud<br/>binary labels &middot; RQ1, RQ2"]
        RC["Real-CATS<br/>criminal categories &middot; RQ3"]
        BL["BLTE<br/>appendix replication"]
        SY["Synthetic fixtures<br/>counter validation"]
        HF ~~~ RC ~~~ BL ~~~ SY
    end

    subgraph PIPE["Locked pipeline &middot; run_results.py  (detailed in the pipeline figure)"]
        direction LR
        PREP["Prepare<br/>eligibility, cohorts, folds"]
        LOCK[["Locked artifacts<br/>protocol.json + Parquet"]]
        EXEC["Execute<br/>graph, motifs, models, tests"]
        PREP --> LOCK --> EXEC
    end

    subgraph RES["Reported results &middot; Chapter 5"]
        direction LR
        R1["RQ1 ablation<br/>baseline / motifs / combined"]
        R2["RQ2 window curve<br/>+ selected &delta;"]
        R3["RQ3 separability<br/>+ per-category &delta;"]
        RA["Robustness<br/>orderings, BLTE, synthetic"]
        R1 ~~~ R2 ~~~ R3 ~~~ RA
    end

    RQ --> DATA --> PIPE --> RES

    classDef lock fill:#f2dede,stroke:#a94442,stroke-width:1.5px;
    class LOCK lock;
